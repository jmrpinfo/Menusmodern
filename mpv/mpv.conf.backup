# Habilitar recuperação de posição
save-position-on-quit=yes
sub-color='#FFFF00'       # Amarelo
sub-border-color='#000000' # Preto
sub-border-size=2          # Tamanho da borda
# Preferência de idioma do áudio
alang=pt-BR
volume-max=200
volume=80
# Altera a cor da OSD para amarelo
osd-bar-h=3
osd-color='#FFFF00'  # Altera a cor da OSD para amarelo
osc = no
border = no
autofit=1536x864



